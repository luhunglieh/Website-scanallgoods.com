---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/contact/ContactSection.astro';
import { path } from '../utils/paths';
---

<BaseLayout 
  title="聯絡資訊 - 端詳互動資訊 Scan All Goods" 
  description="端詳互動資訊聯絡方式：10457 臺北市中山區南京東路二段101號9樓，服務信箱 service@scanallgoods.com。"
  currentPath={path('/contact')}
>
  <!-- Unified Extended High-End Reception Office Background (100% Identical to Services Page Standard) -->
  <div class="relative overflow-hidden">
    <!-- Continuous Background: Scale-100 (No Distortion), Crisp & High Clarity -->
    <div class="absolute inset-0 z-0">
      <img 
        src={path('/img/contact_hero_banner.webp')} 
        alt="端詳互動資訊接待大廳與辦公空間" 
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover object-[80%_15%] sm:object-[75%_10%] lg:object-top scale-100 opacity-95"
      />
      <!-- Crystal clear ambient gradient overlay (Identical to Services Page) -->
      <div class="absolute inset-0 bg-gradient-to-b from-[#f5f5f7]/10 via-[#f5f5f7]/20 to-[#f5f5f7]"></div>
    </div>

    <!-- Generous Top Spacing: Matching Services Page -->
    <div class="relative z-10 pt-60 sm:pt-72 md:pt-80 lg:pt-96"></div>

    <!-- Contact Cards Section -->
    <div class="relative z-10 pb-20">
      <ContactSection />
    </div>
  </div>
</BaseLayout>