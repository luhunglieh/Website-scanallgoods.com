---
const contacts = [
  {
    id: 'address',
    category: '公司地址',
    title: '10457 臺北市中山區',
    detail: '南京東路二段 101 號 9 樓',
    note: '歡迎預約商務洽談，我們將竭誠為您服務',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    color: 'text-brand-green'
  },
  {
    id: 'email',
    category: '服務信箱',
    title: '電子郵件聯繫',
    detail: 'service@scanallgoods.com',
    link: 'mailto:service@scanallgoods.com',
    note: '來信請附上需求說明與聯絡方式',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
    color: 'text-brand-blue'
  },
  {
    id: 'careers',
    category: '職缺快報',
    title: '人才招募',
    detail: '加入端詳互動團隊',
    note: 'HR 於兩日內回覆，目前沒有職缺。',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
    color: 'text-brand-orange'
  }
];
---

<section id="contact-info" class="relative z-10 py-10 bg-transparent scroll-mt-96">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Contact Info Cards List with Target Highlight and Protected Top Scroll Margin -->
    <div class="w-full max-w-[420px] sm:max-w-[460px] mr-auto space-y-5">
      {contacts.map(c => (
        <div 
          id={c.id} 
          class="apple-card p-6 sm:p-7 rounded-3xl bg-white/95 backdrop-blur-xl border border-white/80 shadow-lg flex flex-col justify-between group scroll-mt-96 target:ring-2 target:ring-brand-green target:border-brand-green target:shadow-xl transition-all duration-300"
        >
          <div>
            <!-- Header with Icon & Category -->
            <div class="flex items-center gap-4 mb-4">
              <div class={`w-12 h-12 rounded-2xl bg-[#f5f5f7] ${c.color} flex items-center justify-center shrink-0 shadow-inner group-hover:scale-110 transition-transform duration-300`}>
                <Fragment set:html={c.icon} />
              </div>
              <div>
                <!-- Unified Tag Size: text-sm sm:text-base font-bold -->
                <span class="text-sm sm:text-base font-bold uppercase tracking-wider text-[#86868b] block mb-0.5">
                  {c.category}
                </span>
                <h3 class="text-lg sm:text-xl font-bold text-[#1d1d1f]">
                  {c.title}
                </h3>
              </div>
            </div>

            <!-- Detail -->
            <div class="mb-4 pl-1">
              {c.link ? (
                <a href={c.link} class="text-base font-semibold text-brand-green hover:underline">
                  {c.detail}
                </a>
              ) : (
                <p class="text-base font-medium text-[#1d1d1f]">
                  {c.detail}
                </p>
              )}
            </div>
          </div>

          <!-- Bottom Note -->
          <div class="pt-3 border-t border-black/5">
            <span class="text-xs sm:text-sm font-medium text-[#6e6e73] block">
              {c.note}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>