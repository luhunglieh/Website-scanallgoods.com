---
const screenshots = [
  { img: '/img/screenShoot1.webp', alt: '防偽掃描與即時驗證', rotate: '-rotate-3 hover:rotate-0', translate: 'sm:-translate-y-4', zIndex: 'z-10' },
  { img: '/img/screenShoot2.webp', alt: '數位產品履歷與保固', rotate: 'rotate-2 hover:rotate-0', translate: 'sm:translate-y-6', zIndex: 'z-20' },
  { img: '/img/screenShoot3.webp', alt: '倒數提醒與通知推播', rotate: '-rotate-2 hover:rotate-0', translate: 'sm:-translate-y-2', zIndex: 'z-10' },
  { img: '/img/screenShoot4.webp', alt: '精準行銷與顧客互動', rotate: 'rotate-3 hover:rotate-0', translate: 'sm:translate-y-4', zIndex: 'z-20' },
];
---

<section id="yascan" class="py-24 bg-[#ffffff]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-5xl font-bold text-[#1d1d1f] tracking-tight mb-4">
        Ya!Scan 雲端防偽與保固系統
      </h2>
      <div class="w-16 h-1 bg-brand-green mx-auto rounded-full"></div>
    </div>

    <!-- App 3 Major Highlights -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20 max-w-5xl mx-auto">
      <div class="apple-card p-8 rounded-3xl text-center bg-[#fbfbfd]">
        <div class="w-12 h-12 rounded-2xl bg-brand-green/10 text-brand-green flex items-center justify-center mx-auto mb-4 font-bold text-xl">
          1
        </div>
        <h3 class="text-xl font-semibold text-[#1d1d1f] mb-2">原創精神 · 專利防偽</h3>
        <p class="text-[#6e6e73] text-sm sm:text-base font-normal leading-relaxed">
          一物一碼專利機制，原廠正品首次驗證即鎖定，杜絕水貨竄貨與仿冒偽品。
        </p>
      </div>

      <div class="apple-card p-8 rounded-3xl text-center bg-[#fbfbfd]">
        <div class="w-12 h-12 rounded-2xl bg-brand-green/10 text-brand-green flex items-center justify-center mx-auto mb-4 font-bold text-xl">
          2
        </div>
        <h3 class="text-xl font-semibold text-[#1d1d1f] mb-2">全方位保固與保存提醒</h3>
        <p class="text-[#6e6e73] text-sm sm:text-base font-normal leading-relaxed">
          無紙化數位手冊與保固期程主動通知，提升消費者信任感與品牌滿意度。
        </p>
      </div>

      <div class="apple-card p-8 rounded-3xl text-center bg-[#fbfbfd]">
        <div class="w-12 h-12 rounded-2xl bg-brand-green/10 text-brand-green flex items-center justify-center mx-auto mb-4 font-bold text-xl">
          3
        </div>
        <h3 class="text-xl font-semibold text-[#1d1d1f] mb-2">一對一精準行銷與回購</h3>
        <p class="text-[#6e6e73] text-sm sm:text-base font-normal leading-relaxed">
          適時推播新品與專屬優惠，直接串聯品牌電商 App，實現顧客終身價值 (CLV)。
        </p>
      </div>
    </div>

    <!-- Creative Layered Dynamic Showcase (Dynamic Cascading Layout) -->
    <div class="max-w-6xl mx-auto pt-6 pb-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:-space-x-6 items-center justify-center">
        {screenshots.map((s, idx) => (
          <div class={`relative ${s.zIndex} ${s.translate} transition-all duration-500 transform ${s.rotate} hover:scale-105 hover:z-30`}>
            <div class="apple-card p-3.5 rounded-[2.5rem] bg-white border border-black/10 shadow-2xl overflow-hidden group">
              <div class="rounded-[2rem] overflow-hidden bg-black/5 flex items-center justify-center">
                <img 
                  src={s.img} 
                  alt={s.alt} 
                  class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-300" 
                />
              </div>
              <div class="pt-3 pb-1 text-center">
                <span class="text-xs font-semibold text-[#6e6e73] group-hover:text-brand-green transition-colors">
                  {s.alt}
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>