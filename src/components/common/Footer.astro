---
import { path } from '../../utils/paths';

const currentYear = new Date().getFullYear();
---

<footer id="footer" class="relative z-20 bg-[#f5f5f7] text-[#424245] text-sm border-t border-black/10 py-14">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-10">
      <!-- Left Column: Company Info + Tax ID + Links + Rotary -->
      <div class="space-y-4">
        <div>
          <img src={path('/img/myicon.webp')} alt="端詳互動資訊 Logo" class="w-8 h-8 object-contain" />
        </div>
        <div class="pt-1">
          <h4 class="text-[#1d1d1f] font-semibold text-base leading-tight">
            端詳互動資訊有限公司
          </h4>
          <p class="text-sm font-normal text-[#6e6e73] mt-1.5 leading-tight">
            統一編號：24778439
          </p>
        </div>

        <!-- Links under Tax ID: 聯絡資訊 & 職缺快報 -->
        <div class="pt-1 flex items-center gap-4 flex-wrap">
          <a href={path('/contact')} class="text-sm font-medium text-brand-green hover:underline">
            聯絡資訊 &rarr;
          </a>
          <a href={path('/contact')} class="text-sm font-medium text-brand-green hover:underline">
            職缺快報 &rarr;
          </a>
        </div>

        <!-- Rotary Icon + 社服網站贊助 -->
        <div class="pt-3 border-t border-black/5 space-y-2">
          <div>
            <div class="inline-flex items-center px-3.5 py-1.5 rounded-xl bg-[#005DAA] shadow-sm">
              <img src={path('/img/rotary-white-logo.svg')} alt="Rotary International Logo" class="h-6 w-auto object-contain" />
            </div>
          </div>
          <div>
            <a href={path('/sponsorship')} class="text-sm font-semibold text-[#1d1d1f] hover:text-brand-green transition-colors block">
              社服網站贊助
            </a>
          </div>
        </div>
      </div>

      <!-- Services Navigation (Precise Card Anchors) -->
      <div class="space-y-3">
        <h4 class="text-[#1d1d1f] font-semibold text-base">
          <a href={path('/services')} class="hover:text-brand-green transition-colors">服務項目</a>
        </h4>
        <ul class="space-y-2 text-sm font-normal text-[#6e6e73]">
          <li><a href={path('/services#agentic')} class="hover:text-brand-green transition-colors">Agentic程式設計</a></li>
          <li><a href={path('/services#ecommerce')} class="hover:text-brand-green transition-colors">跨境電商代理營運</a></li>
          <li><a href={path('/services#it-consulting')} class="hover:text-brand-green transition-colors">資訊應用規劃設計</a></li>
          <li><a href={path('/services#data-analysis')} class="hover:text-brand-green transition-colors">數據分析營運決策</a></li>
          <li><a href={path('/services#customers')} class="hover:text-brand-green transition-colors">成功合作案例</a></li>
        </ul>
      </div>

      <!-- Products Navigation -->
      <div class="space-y-3">
        <h4 class="text-[#1d1d1f] font-semibold text-base">
          <a href={path('/products')} class="hover:text-brand-green transition-colors">產品資訊</a>
        </h4>
        <ul class="space-y-2 text-sm font-normal text-[#6e6e73]">
          <li><a href={path('/products#security')} class="hover:text-brand-green transition-colors">安全線上防偽方案</a></li>
          <li><a href={path('/products#warranty')} class="hover:text-brand-green transition-colors">線上保固資訊系統</a></li>
          <li><a href={path('/products#marketing')} class="hover:text-brand-green transition-colors">一對一精準行銷</a></li>
          <li><a href={path('/products#patent')} class="hover:text-brand-green transition-colors">國家發明專利與商標</a></li>
        </ul>
      </div>

      <!-- Sponsorship Navigation -->
      <div class="space-y-3">
        <h4 class="text-[#1d1d1f] font-semibold text-base">
          <a href={path('/sponsorship')} class="hover:text-brand-green transition-colors">社服贊助</a>
        </h4>
        <ul class="space-y-2 text-sm font-normal text-[#6e6e73]">
          <li><a href={path('/sponsorship')} class="hover:text-brand-green transition-colors">相信幸福特展</a></li>
          <li><a href={path('/sponsorship')} class="hover:text-brand-green transition-colors">讓愛飛翔</a></li>
          <li><a href={path('/sponsorship')} class="hover:text-brand-green transition-colors">扶輪大手牽小手</a></li>
          <li><a href={path('/sponsorship')} class="hover:text-brand-green transition-colors">企業社會責任 (CSR)</a></li>
        </ul>
      </div>
    </div>

    <!-- Copyright & Prominent Back-to-Top Button -->
    <div class="pt-8 border-t border-black/10 flex flex-col sm:flex-row items-center justify-between gap-5 text-sm font-normal text-[#6e6e73]">
      <div>
        © <span id="copyright-year">{currentYear}</span> 端詳互動資訊有限公司 ｜ <a href={path('/sponsorship')} class="hover:text-brand-green transition-colors underline-offset-2 hover:underline">企業社會責任</a> ｜ 服務條款 ｜ 隱私權政策
      </div>
      <div>
        <a 
          href="#top" 
          id="back-to-top-btn"
          class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-white hover:bg-brand-green text-[#1d1d1f] hover:text-black font-semibold text-sm shadow-md border border-black/10 hover:border-brand-green transition-all duration-300 group active:scale-95"
        >
          <span>回到頂部</span>
          <span class="w-6 h-6 rounded-full bg-[#f5f5f7] group-hover:bg-black/10 flex items-center justify-center transition-colors">
            <svg class="w-3.5 h-3.5 text-[#1d1d1f] group-hover:-translate-y-0.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  const yearEl = document.getElementById('copyright-year');
  if (yearEl) {
    yearEl.textContent = new Date().getFullYear();
  }

  const backToTopBtn = document.getElementById('back-to-top-btn');
  backToTopBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>