---
---

<section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden pt-28 pb-20 px-4">
  <!-- AI Consultant High-Tech Background -->
  <div class="absolute inset-0 z-0 flex items-center justify-center">
    <img 
      src="/img/ai_hero_banner.webp" 
      alt="端詳互動資訊 AI 專家與顧問主視覺" 
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="w-full h-full object-cover object-center sm:object-[center_35%] opacity-85"
    />
    <!-- Subtle Vignette & Gradient Overlays -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#f5f5f7]/70 via-[#f5f5f7]/40 to-[#f5f5f7]"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#f5f5f7]/60 via-transparent to-[#f5f5f7]/60"></div>
  </div>

  <!-- Content Container -->
  <div class="relative z-10 max-w-4xl mx-auto text-center px-4 sm:px-6">
    <!-- Patent & AI Badges (Clear and separated) -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-8">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/95 border border-black/10 text-sm font-medium text-[#1d1d1f] shadow-sm backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-brand-green"></span>
        <span>國家發明專利 I625685號</span>
      </div>
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/95 border border-black/10 text-sm font-medium text-[#1d1d1f] shadow-sm backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-brand-blue"></span>
        <span>生成式 AI 賦能</span>
      </div>
    </div>

    <!-- Apple-style Headline -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-[#1d1d1f] mb-6 leading-tight">
      資訊服務專家
    </h1>

    <!-- Highlight Content Box (Avoid mid-phrase line breaks; breaks cleanly at '雲端線上防偽' on mobile) -->
    <div class="bg-white/85 backdrop-blur-md rounded-2xl py-4 px-6 sm:px-8 max-w-2xl mx-auto mb-10 border border-black/10 shadow-sm">
      <p class="text-lg sm:text-2xl md:text-3xl font-semibold text-brand-green tracking-tight leading-snug">
        <span class="whitespace-nowrap inline-block">AI應用規劃 · 資料與商業分析</span>
        <span class="hidden sm:inline"> · </span>
        <span class="whitespace-nowrap block sm:inline mt-1 sm:mt-0">雲端線上防偽</span>
      </p>
    </div>

    <!-- CTAs linking to multi-page routes (No arrow on 探索產品資訊) -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a 
        href="/services"
        class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-brand-green hover:bg-brand-green-dark text-black font-semibold text-base transition-all duration-200 shadow-md hover:scale-105 text-center"
      >
        了解服務項目
      </a>
      <a 
        href="/products"
        class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-white/95 hover:bg-white text-[#1d1d1f] font-semibold text-base border border-black/10 transition-all duration-200 text-center shadow-sm backdrop-blur-md"
      >
        探索產品資訊
      </a>
    </div>
  </div>
</section>