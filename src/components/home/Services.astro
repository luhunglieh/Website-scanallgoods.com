---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  {
    title: '跨境電商代理營運',
    desc: '我們是實際販賣商品的代理營運商，熟悉 Amazon 跨境電商平台的規定與操作，同時瞭解各國海關規定、交易收款與物流配送方式。亦可協助操作社群廣告，並根據統計數字，提供企業邁向全球銷售的建議。',
    icon: '/img/service1.webp',
    accent: 'border-l-4 border-brand-blue',
  },
  {
    title: '行動裝置系統開發',
    desc: '我們自有研發 Ya!Scan app 並取得國家發明專利，讓商家能透過行動裝置發展顧客關係管理、推廣售後服務、再行銷與促進顧客回購，並經由多維度分析與圖表輔助營運，讓企業洞見數據的奧秘與商務的契機。',
    icon: '/img/service2.webp',
    accent: 'border-l-4 border-brand-rose',
  },
  {
    title: '資訊應用規劃設計',
    desc: '我們因應企業需求客製專屬資訊系統，滿足商務應用並提供管理所需的報表，以提升企業效能進而增加營運獲利。並能排除各系統間的壁壘進行資料整合與匯流，優化數據資料與報表以增益跨單位間的合作。',
    icon: '/img/service3.webp',
    accent: 'border-l-4 border-brand-green',
  },
  {
    title: '數據分析營運決策',
    desc: '我們跟隨企業深入了解業務範疇，將其作業流程中的資料加以探討、研究，如商品製程的成分分析、顧客瀏覽喜好統計、顧客樣貌與消費分析...，搭配產業獨有的數據模型，提供圖像化利器輔助高階主管決策。',
    icon: '/img/service4.webp',
    accent: 'border-l-4 border-brand-orange',
  }
];
---

<section id="service" class="py-24 bg-[#f5f5f7] dark:bg-apple-darkbg transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-semibold text-brand-green bg-brand-green/10 px-3 py-1 rounded-full uppercase tracking-wider inline-block mb-3">
        服務項目 · 顧問與營運
      </span>
      <h2 class="text-3xl sm:text-5xl font-bold text-[#1d1d1f] dark:text-white tracking-tight mb-4">
        {t('service.title')}
      </h2>
      <div class="w-16 h-1 bg-brand-green mx-auto mb-6 rounded-full"></div>
      <p class="text-[#424245] dark:text-[#a1a1a6] text-base sm:text-lg font-normal leading-relaxed">
        {t('service.subtitle')}
      </p>
    </div>

    <!-- Apple 4-Grid Services Showcase (Refined font weights) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {services.map(s => (
        <div class={`apple-card ${s.accent} p-8 sm:p-10 rounded-3xl flex flex-col justify-between group`}>
          <div class="flex items-center gap-5 mb-6">
            <div class="w-14 h-14 rounded-2xl bg-black/5 dark:bg-white/10 p-2.5 flex items-center justify-center shrink-0">
              <img src={s.icon} alt={s.title} class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />
            </div>
            <h3 class="text-xl sm:text-2xl font-semibold text-[#1d1d1f] dark:text-white group-hover:text-brand-green transition-colors">
              {s.title}
            </h3>
          </div>
          <p class="text-[#424245] dark:text-[#d1d1d6] text-base font-normal leading-relaxed text-justify">
            {s.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>